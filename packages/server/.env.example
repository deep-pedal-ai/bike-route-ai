PORT=3000

# Neon Postgres — the corpus read seam. Copy this file to .env and fill in.
# The app and all tests are READ-ONLY (SELECT only); prefer a read-only role.

# Runtime DB — live corpus (Neon project freewheel-corpus, branch: main)
DATABASE_URL=postgres://app_readonly:password@host/database

# Integration/E2E test DB — a disposable Neon child branch off main.
# Integration tests skip cleanly when this is unset.
TEST_DATABASE_URL=

# OpenAI — powers natural-language route search (embeddings + chat rerank).
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
